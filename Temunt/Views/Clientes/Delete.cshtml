@model Temunt.Models.clientes

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-5">

    <h2 class="text-danger mb-4">Eliminar Cliente</h2>

    <p class="fs-5 mb-4">¿Estás seguro que deseas eliminar este cliente?</p>

    <div class="row mb-4">
        <div class="col-md-6">

            <p><strong>Nombre:</strong> @Model.nombre</p>
            <p><strong>Empresa:</strong> @Model.empresa</p>
            <p><strong>Email:</strong> @Model.email</p>

        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id_cliente" />

        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-danger px-4">Eliminar</button>

            <a asp-action="Index" class="btn btn-secondary px-4">
                Cancelar
            </a>
        </div>
    </form>

</div>
