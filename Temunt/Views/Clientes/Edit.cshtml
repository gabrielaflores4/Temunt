@model Temunt.Models.clientes

@{
    ViewData["Title"] = "Editar Cliente";
    Layout = "_Layout";
}

<div class="container-fluid p-4" style="background-color:#f8f9fc;">
    <div class="d-flex justify-content-center">
        <div class="card shadow p-4" style="max-width:600px; width:100%; border-radius:10px;">
            <h3 class="text-center mb-4 fw-bold">Editar Cliente</h3>

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="id_cliente" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="fw-semibold">Nombre</label>
                    <input asp-for="nombre" class="form-control" />
                    <span asp-validation-for="nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="fw-semibold">Empresa</label>
                    <input asp-for="empresa" class="form-control" />
                    <span asp-validation-for="empresa" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="fw-semibold">Contacto</label>
                    <input asp-for="contacto" class="form-control" />
                    <span asp-validation-for="contacto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="fw-semibold">Teléfono</label>
                    <input asp-for="telefono" class="form-control" />
                    <span asp-validation-for="telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="fw-semibold">Email</label>
                    <input asp-for="email" class="form-control" type="email" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index"
                       class="btn px-4"
                       style="background-color:#B91C1C; color:white; border-radius:6px;">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn px-4"
                            style="background-color:#070d2f; color:white; border-radius:6px;">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
