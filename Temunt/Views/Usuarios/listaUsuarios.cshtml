@model IEnumerable<Temunt.Models.usuarios>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid p-4" style="background-color: #f8f9fc;">
    <div class="row">
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark mb-0">Usuarios</h2>

                <a asp-action="Create" asp-controller="Usuarios" class="btn btn-crear">
                    AÑADIR USUARIO
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #f7f9fc;">
                            <tr>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Usuario</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Persona</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Email</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Teléfono</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Rol</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0 text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var usuario in Model)
                                {
                                    <tr style="border-bottom: 1px solid #e9ecef;">
                                        <td class="px-4 py-3 fw-medium text-dark">@usuario.nombreU</td>
                                        <td class="px-4 py-3 text-muted">@usuario.nombreP</td>
                                        <td class="px-4 py-3 text-muted">@usuario.email</td>
                                        <td class="px-4 py-3">
                                            <a href="tel:@usuario.telefono" class="text-decoration-none fw-medium">
                                                @usuario.telefono
                                            </a>
                                        </td>
                                        <td class="px-4 py-3 fw-medium">@usuario.roles</td>
                                        <td class="px-4 py-3 text-center">
                                            <a asp-action="EditarUsuario" asp-route-id="@usuario.id_usuario"
                                               class="btn btn-detalles me-2">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a asp-action="EliminarUsuario" asp-route-id="@usuario.id_usuario"
                                               class="btn btn-cancelar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa fa-users fa-2x mb-3"></i>
                                        <div>No hay usuarios registrados</div>
                                        <a asp-action="Create" asp-controller="Usuarios" class="btn btn-crear mt-3">
                                            Crear primer usuario
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
