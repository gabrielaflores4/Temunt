@model IEnumerable<Temunt.Models.proveedores>

@{
    ViewData["Title"] = "Proveedores";
    Layout = "_Layout";
}

<div class="container-fluid p-4" style="background-color: #f8f9fc;">
    <div class="row">
        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark mb-0">Proveedores</h2>

                <a asp-action="Create" class="btn btn-crear">
                    AÑADIR PROVEEDOR
                </a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #f7f9fc;">
                            <tr>
                                <th class="text-muted fw-normal py-3 px-4 border-0">ID</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Nombre</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Dirección</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Teléfono</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0">Email</th>
                                <th class="text-muted fw-normal py-3 px-4 border-0 text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr style="border-bottom: 1px solid #e9ecef;">
                                        <td class="px-4 py-3 fw-medium">@item.id_prov.ToString("D4")</td>
                                        <td class="px-4 py-3 text-dark fw-medium">@item.nombre</td>
                                        <td class="px-4 py-3 text-muted">@item.direccion</td>

                                        <td class="px-4 py-3">
                                            <a href="tel:@item.telefono" class="text-decoration-none fw-medium">
                                                @item.telefono
                                            </a>
                                        </td>

                                        <td class="px-4 py-3 text-muted">@item.email</td>

                                        <td class="px-4 py-3 text-center">
                                            <a asp-action="Edit" asp-route-id="@item.id_prov"
                                               class="btn btn-detalles me-2">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            <a asp-action="EliminarProveedor"
                                               asp-route-id="@item.id_prov"
                                               class="btn btn-cancelar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-truck fa-2x mb-3"></i>
                                        <div>No hay proveedores registrados</div>
                                        <a asp-action="Create" class="btn btn-crear mt-3">
                                            Crear primer proveedor
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
