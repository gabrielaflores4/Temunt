@model Temunt.Models.proveedores

@{
    ViewData["Title"] = "Editar Proveedor";
    Layout = "_Layout";
}

<div class="container-fluid p-4" style="background-color:#f8f9fc;">
    <div class="d-flex justify-content-center">
        <div class="card shadow p-4" style="max-width:600px; width:100%; border-radius:10px;">

            <h3 class="text-center mb-5 fw-bold">Editar Proveedor</h3>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id_prov" />

                <div class="mb-4">
                    <label class="fw-semibold">Nombre</label>
                    <input asp-for="nombre" class="form-control" />
                </div>

                <div class="mb-4">
                    <label class="fw-semibold">Dirección</label>
                    <input asp-for="direccion" class="form-control" />
                </div>

                <div class="mb-4">
                    <label class="fw-semibold">Teléfono</label>
                    <input asp-for="telefono" class="form-control" />
                </div>

                <div class="mb-4">
                    <label class="fw-semibold">Email</label>
                    <input asp-for="email" type="email" class="form-control" />
                </div>

                <div class="d-flex justify-content-between mt-5">
                    <a asp-action="Index"
                       class="btn px-4"
                       style="background-color:#B91C1C; color:white; border-radius:6px;">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn px-4"
                            style="background-color:#070d2f; color:white; border-radius:6px;">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
